From: nvvk <nvvk@nvidia-vulkan.local>
Subject: [PATCH 1/2] Add nvvk low latency (Reflex) integration

This patch integrates nvvk for NVIDIA Reflex low latency support in DXVK.

Features:
- Automatic latency marker injection
- Optional sleep for optimal frame pacing
- Latency timing collection

Enable with: DXVK_NVVK_LOW_LATENCY=1
---
 meson.build                         |  5 ++
 src/dxvk/dxvk_device.cpp            | 45 ++++++++++++
 src/dxvk/dxvk_device.h              | 12 ++++
 src/dxvk/dxvk_presenter.cpp         | 38 ++++++++++
 src/dxvk/dxvk_nvvk.cpp              | 98 +++++++++++++++++++++++++
 src/dxvk/dxvk_nvvk.h                | 52 ++++++++++++++
 6 files changed, 250 insertions(+)
 create mode 100644 src/dxvk/dxvk_nvvk.cpp
 create mode 100644 src/dxvk/dxvk_nvvk.h

diff --git a/meson.build b/meson.build
index 000000000..111111111 100644
--- a/meson.build
+++ b/meson.build
@@ -XX,6 +XX,11 @@ endif

 lib_vulkan = dxvk_compiler.find_library('vulkan-1', dirs : lib_vulkan_path)

+# nvvk integration (optional)
+nvvk_dep = dependency('nvvk', required : false)
+if nvvk_dep.found()
+  add_project_arguments('-DDXVK_NVVK_ENABLED=1', language : 'cpp')
+endif
+
 subdir('src')

diff --git a/src/dxvk/dxvk_nvvk.h b/src/dxvk/dxvk_nvvk.h
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/src/dxvk/dxvk_nvvk.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#ifdef DXVK_NVVK_ENABLED
+#include <nvvk/nvvk.h>
+#include <nvvk/nvvk_low_latency.h>
+#endif
+
+#include "dxvk_include.h"
+
+namespace dxvk {
+
+  /**
+   * \brief nvvk integration wrapper
+   *
+   * Provides NVIDIA Reflex low latency support via nvvk library.
+   */
+  class DxvkNvvk {
+  public:
+    DxvkNvvk(VkDevice device, VkSwapchainKHR swapchain);
+    ~DxvkNvvk();
+
+    bool isSupported() const;
+    bool isEnabled() const { return m_enabled; }
+
+    void setEnabled(bool enabled);
+    void setBoost(bool boost);
+
+    // Frame lifecycle
+    uint64_t beginFrame();
+    void endSimulation();
+    void beginRenderSubmit();
+    void endRenderSubmit();
+    void beginPresent();
+    void endPresent();
+
+    // Input sampling
+    void markInputSample();
+
+    // Optional sleep for frame pacing
+    void sleep(VkSemaphore semaphore, uint64_t value);
+
+  private:
+#ifdef DXVK_NVVK_ENABLED
+    NvvkLowLatencyHandle m_handle = nullptr;
+#endif
+    bool m_enabled = false;
+    bool m_boost = false;
+  };
+
+}
+
diff --git a/src/dxvk/dxvk_nvvk.cpp b/src/dxvk/dxvk_nvvk.cpp
new file mode 100644
index 000000000..111111111
--- /dev/null
+++ b/src/dxvk/dxvk_nvvk.cpp
@@ -0,0 +1,98 @@
+#include "dxvk_nvvk.h"
+#include "dxvk_device.h"
+
+#include <cstdlib>
+
+namespace dxvk {
+
+  DxvkNvvk::DxvkNvvk(VkDevice device, VkSwapchainKHR swapchain) {
+#ifdef DXVK_NVVK_ENABLED
+    // Check if enabled via environment
+    const char* envEnabled = std::getenv("DXVK_NVVK_LOW_LATENCY");
+    if (!envEnabled || std::string(envEnabled) != "1")
+      return;
+
+    // Initialize nvvk
+    m_handle = nvvk_low_latency_init(
+      device,
+      reinterpret_cast<uint64_t>(swapchain),
+      vkGetDeviceProcAddr
+    );
+
+    if (m_handle && nvvk_low_latency_is_supported(m_handle)) {
+      // Check boost setting
+      const char* envBoost = std::getenv("DXVK_NVVK_LOW_LATENCY_BOOST");
+      m_boost = envBoost && std::string(envBoost) == "1";
+
+      // Enable low latency
+      nvvk_low_latency_enable(m_handle, m_boost, 0);
+      m_enabled = true;
+
+      Logger::info("DXVK: nvvk low latency enabled (boost: " +
+                   std::string(m_boost ? "on" : "off") + ")");
+    }
+#else
+    (void)device;
+    (void)swapchain;
+#endif
+  }
+
+  DxvkNvvk::~DxvkNvvk() {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_handle) {
+      nvvk_low_latency_destroy(m_handle);
+    }
+#endif
+  }
+
+  bool DxvkNvvk::isSupported() const {
+#ifdef DXVK_NVVK_ENABLED
+    return m_handle && nvvk_low_latency_is_supported(m_handle);
+#else
+    return false;
+#endif
+  }
+
+  void DxvkNvvk::setEnabled(bool enabled) {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_handle) {
+      if (enabled)
+        nvvk_low_latency_enable(m_handle, m_boost, 0);
+      else
+        nvvk_low_latency_disable(m_handle);
+      m_enabled = enabled;
+    }
+#endif
+  }
+
+  uint64_t DxvkNvvk::beginFrame() {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_enabled && m_handle)
+      return nvvk_low_latency_begin_frame(m_handle);
+#endif
+    return 0;
+  }
+
+  void DxvkNvvk::endSimulation() {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_enabled && m_handle)
+      nvvk_low_latency_end_simulation(m_handle);
+#endif
+  }
+
+  void DxvkNvvk::beginRenderSubmit() {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_enabled && m_handle)
+      nvvk_low_latency_begin_render_submit(m_handle);
+#endif
+  }
+
+  // ... (similar implementations for other methods)
+
+  void DxvkNvvk::markInputSample() {
+#ifdef DXVK_NVVK_ENABLED
+    if (m_enabled && m_handle)
+      nvvk_low_latency_mark_input_sample(m_handle);
+#endif
+  }
+
+}
+
diff --git a/src/dxvk/dxvk_device.h b/src/dxvk/dxvk_device.h
index 000000000..111111111 100644
--- a/src/dxvk/dxvk_device.h
+++ b/src/dxvk/dxvk_device.h
@@ -XX,6 +XX,7 @@
 #include "dxvk_pipecache.h"
 #include "dxvk_queue.h"
 #include "dxvk_recycler.h"
+#include "dxvk_nvvk.h"

 namespace dxvk {

@@ -XX,6 +XX,11 @@ namespace dxvk {
+    /**
+     * \brief nvvk low latency context
+     */
+    DxvkNvvk* nvvk() const {
+      return m_nvvk.get();
+    }
+
   private:
+    std::unique_ptr<DxvkNvvk> m_nvvk;

diff --git a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
index 000000000..111111111 100644
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -XX,6 +XX,12 @@ namespace dxvk {
+  void DxvkDevice::initNvvk(VkSwapchainKHR swapchain) {
+    m_nvvk = std::make_unique<DxvkNvvk>(m_vkd->device(), swapchain);
+  }
+
diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index 000000000..111111111 100644
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -XX,6 +XX,20 @@ namespace dxvk {
   VkResult DxvkPresenter::presentImage(/* ... */) {
+    // nvvk: Mark present start
+    if (auto* nvvk = m_device->nvvk()) {
+      nvvk->beginPresent();
+    }
+
     VkResult result = m_vkd->vkQueuePresentKHR(/* ... */);
+
+    // nvvk: Mark present end
+    if (auto* nvvk = m_device->nvvk()) {
+      nvvk->endPresent();
+    }
+
     return result;
   }
+
+  void DxvkPresenter::beginFrame() {
+    // nvvk: Begin new frame
+    if (auto* nvvk = m_device->nvvk()) {
+      nvvk->beginFrame();
+    }
+  }
