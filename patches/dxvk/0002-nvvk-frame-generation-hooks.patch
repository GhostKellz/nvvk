 namespace dxvk {

@@ -XX,6 +XX,12 @@ namespace dxvk {
+    /**
+     * \brief nvvk frame generation context
+     */
+    DxvkNvvkFrameGen* frameGen() const {
+      return m_frameGen.get();
+    }
+
   private:
+    std::unique_ptr<DxvkNvvkFrameGen> m_frameGen;

diff --git a/src/dxvk/dxvk_presenter.cpp b/src/dxvk/dxvk_presenter.cpp
index 000000000..111111111
--- a/src/dxvk/dxvk_presenter.cpp
+++ b/src/dxvk/dxvk_presenter.cpp
@@ -XX,6 +XX,30 @@ namespace dxvk {
   void DxvkPresenter::recreateSwapchain(/* ... */) {
     // ... existing swapchain recreation code ...

+    // Initialize or update frame generation
+    if (!m_frameGen) {
+      m_frameGen = std::make_unique<DxvkNvvkFrameGen>(
+        m_device->handle(),
+        m_device->adapter()->handle(),
+        m_swapchain,
+        m_info.imageExtent.width,
+        m_info.imageExtent.height
+      );
+    } else {
+      m_frameGen->onSwapchainRecreate(
+        m_swapchain,
+        m_info.imageExtent.width,
+        m_info.imageExtent.height
+      );
+    }
+  }
+
   VkResult DxvkPresenter::presentImage(/* ... */) {
+    // Capture frame for generation before present
+    if (m_frameGen && m_frameGen->isEnabled()) {
+      m_frameGen->onPrePresent(m_images[imageIndex].image, cmdBuffer);
+    }
+
     // nvvk: Mark present start
     if (auto* nvvk = m_device->nvvk()) {
       nvvk->beginPresent();
@@ -XX,6 +XX,55 @@ namespace dxvk {
       nvvk->endPresent();
     }

+    // Frame generation: inject interpolated frame after real present
+    if (m_frameGen && m_frameGen->isEnabled()) {
+      m_frameGen->onPostPresent();
+
+      if (m_frameGen->shouldInjectFrame()) {
+        VkImage generatedFrame = m_frameGen->getGeneratedFrame();
+
+        if (generatedFrame != VK_NULL_HANDLE) {
+          // Acquire next swapchain image for generated frame
+          uint32_t genImageIndex;
+          VkResult acquireResult = vkAcquireNextImageKHR(
+            m_device->handle(),
+            m_swapchain,
+            UINT64_MAX,
+            m_semaphores[m_frameIndex].acquire,
+            VK_NULL_HANDLE,
+            &genImageIndex
+          );
+
+          if (acquireResult == VK_SUCCESS || acquireResult == VK_SUBOPTIMAL_KHR) {
+            // Copy generated frame to swapchain image
+            // (In practice, use a blit or the frame gen writes directly)
+
+            // Present the generated frame
+            VkPresentInfoKHR genPresentInfo = { VK_STRUCTURE_TYPE_PRESENT_INFO_KHR };
+            genPresentInfo.waitSemaphoreCount = 1;
+            genPresentInfo.pWaitSemaphores = &m_semaphores[m_frameIndex].present;
+            genPresentInfo.swapchainCount = 1;
+            genPresentInfo.pSwapchains = &m_swapchain;
+            genPresentInfo.pImageIndices = &genImageIndex;
+
+            vkQueuePresentKHR(m_presentQueue, &genPresentInfo);
+
+            // Log stats periodically
+            auto stats = m_frameGen->getStats();
+            if (stats.generatedFrames % 300 == 0 && stats.generatedFrames > 0) {
+              Logger::debug(str::format(
+                "nvvk frame gen: ",
+                stats.realFrames, " real, ",
+                stats.generatedFrames, " generated, ",
+                stats.effectiveFps, " effective FPS"
+              ));
+            }
+          }
+        }
+      }
+    }
+
     return result;
   }
