 src/dxvk/dxvk_presenter.h       | 18 ++++++
 src/dxvk/dxvk_nvvk_framegen.cpp | 156 ++++++++++++++++++++++++++++++++++++++++
 src/dxvk/dxvk_nvvk_framegen.h   | 78 +++++++++++++++++++++++
 4 files changed, 337 insertions(+)
 create mode 100644 src/dxvk/dxvk_nvvk_framegen.cpp
